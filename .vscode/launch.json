{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch MCP Server",
      "program": "${workspaceFolder}/ts_mcp_server/build/index.js",
      "preLaunchTask": "tsc: build - ts_mcp_server/tsconfig.json",
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Proxy MCP Server",
      "program": "${workspaceFolder}/ts_mcp_proxy/build/index.js",
      "preLaunchTask": "tsc: build - ts_mcp_proxy/tsconfig.json",
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ]
    },
    {
      "type": "dotnet",
      "request": "launch",
      "name": "Launch MCP Client Dotnet",
      "projectPath": "${workspaceFolder}/dotnet_mcp_server/dotnet_mcp_server.csproj",
      "launchConfigurationId": "TargetFramework=;http"
    }
  ]
}